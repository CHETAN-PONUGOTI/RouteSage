# Copy this file to .env and fill in your real API key.
# Do NOT commit .env to git.

# Google Gemini API key for LLM explanation generation.
GEMINI_API_KEY=<your-gemini-api-key>

# Set to true to enable LLM explanations. Defaults to false (deterministic fallback).
ENABLE_LLM_EXPLANATION=false

# Optional: override the Gemini model name.
# GEMINI_MODEL=gemini-2.5-flash
